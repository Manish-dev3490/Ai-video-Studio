# Template only. Preferred: node scripts/start-production.mjs --init
# The init command creates distinct random secrets in ignored .env.production.local.
PRODUCTION_PROFILE=local
NODE_ENV=production
APP_ORIGIN=https://studio.localhost:8443
API_HOST=127.0.0.1
API_PORT=4200
TRUST_PROXY=loopback
ENFORCE_HTTPS=true
REQUEST_LOGGING=true
MONGODB_URI=mongodb://127.0.0.1:27019/ai_video_studio_production_local?replicaSet=avsProductionLocal
AUTO_START_LOCAL_MONGO=true
JWT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
CSRF_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET
MAIL_ENCRYPTION_SECRET=REPLACE_WITH_THIRD_RANDOM_SECRET
# Local-only disabled mode makes no real-email-delivery claim.
MAIL_TRANSPORT=disabled
PRODUCTION_ALLOW_DISABLED_MAIL=true
MAIL_FROM=
RESEND_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PRIVATE_STORAGE_ROOT=var/production/media
WORKER_WORK_ROOT=var/production/jobs
LOCAL_TLS_CERT_FILE=var/production/tls/local-cert.pem
LOCAL_TLS_KEY_FILE=var/production/tls/local-key.pem
