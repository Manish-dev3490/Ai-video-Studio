NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27018/ai_video_studio_phase3
# Run npm run setup:local to generate independent random secrets in ignored .env.
JWT_SECRET=
CSRF_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DAILY_GENERATION_LIMIT=3
ASSISTANT_DAILY_LIMIT=30
REPORT_DAILY_LIMIT=10
MAIL_TRANSPORT=local
MAIL_FROM=AI Video Studio <no-reply@localhost.invalid>
# Resend mode needs a provider key and a verified sender. Never expose these to Vite.
RESEND_API_KEY=
# Optional independent encryption secret; otherwise a domain-separated JWT-derived key is used.
MAIL_ENCRYPTION_SECRET=
